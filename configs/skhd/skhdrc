# https://github.com/koekeishiya/skhd/issues/1

# cmd + h/l/k/j to move focus on windows(Amethyst)
cmd - h : skhd -k "cmd - k"
cmd - l : skhd -k "cmd - j"

# cmd + comma/dot to move focus on screens
cmd - 0x2B : skhd -k "cmd + ctrl - 1"
cmd - 0x2F : skhd -k "cmd + ctrl - 2"

# Right option key as super key (ctrl+shift+option)
ralt - s : skhd -k "ctrl + shift + alt - s"
ralt - p : skhd -k "ctrl + shift + alt - p"
ralt - w : skhd -k "ctrl + shift + alt - w"
ralt - m : skhd -k "ctrl + shift + alt - m"
ralt - n : skhd -k "ctrl + shift + alt - n"
ralt - c : skhd -k "ctrl + shift + alt - c"
ralt - d : skhd -k "ctrl + shift + alt - d"
ralt - h : skhd -k "ctrl + shift + alt - h"
ralt - z : skhd -k "ctrl + shift + alt - z"
ralt - k : skhd -k "ctrl + shift + alt - k"

cmd + shift + ctrl - g : sh ~/Dotmac/scripts/llm-converter pro
cmd + shift + ctrl - f : sh ~/Dotmac/scripts/llm-converter cto
